# Copy this file to .env and fill in real values.

# --- Server ---
PORT=4000

# --- CORS ---
# Must exactly match the origin the frontend is served from
# (protocol + host + port). Example: if you run `npx serve client` the
# default origin is usually http://localhost:3000 — check the terminal
# output when you start it and update this value to match.
CLIENT_ORIGIN=http://localhost:3000

# --- PostgreSQL ---
PGHOST=localhost
PGPORT=5432
PGDATABASE=neon_drop
PGUSER=postgres
PGPASSWORD=postgres
